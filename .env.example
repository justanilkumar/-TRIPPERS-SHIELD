APP_NAME=PolicyFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database Configurations (MySQL 8+, PostgreSQL, or SQLite)
# ------------------------------------------------------------------------------

# Option A: Zero-config SQLite (Default for rapid reviewer evaluation)
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# Option B: MySQL 8+ (Docker compose: `docker compose up -d mysql`)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=policyflow
# DB_USERNAME=policyflow
# DB_PASSWORD=secret

# Option C: PostgreSQL 16 (Docker compose: `docker compose up -d postgres`)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=policyflow
# DB_USERNAME=policyflow
# DB_PASSWORD=secret

# ------------------------------------------------------------------------------
# Queue & Cache Driver
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Optional Redis Configuration (Docker compose: `docker compose up -d redis`)
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
